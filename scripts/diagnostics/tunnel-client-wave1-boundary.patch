+package dispatcherinternal
+
+import (
+	"bytes"
+	"encoding/json"
+	"log/slog"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/modelcontextprotocol/go-sdk/jsonrpc"
+	"github.com/stretchr/testify/require"
+)
+
+func wave1TaggedRequest(t *testing.T, command string) *jsonrpc.Request {
+	t.Helper()
+	params, err := json.Marshal(map[string]any{
+		"name": "terminal_exec",
+		"arguments": map[string]any{
+			"command": command,
+		},
+		"_meta": map[string]any{
+			"existing": "preserved",
+		},
+	})
+	require.NoError(t, err)
+	return &jsonrpc.Request{Method: "tools/call", Params: params}
+}
+
+func TestInjectWave1DispatchIdentityDisabled(t *testing.T) {
+	t.Setenv(wave1TraceEnv, "")
+	req := wave1TaggedRequest(t, "printf RAW_SECRET_FIXTURE # GWC_TRACE_TAG=W1_TEST")
+	before := append([]byte(nil), req.Params...)
+
+	require.Empty(t, injectWave1DispatchIdentity(slog.Default(), req))
+	require.Equal(t, before, []byte(req.Params))
+}
+
+func TestInjectWave1DispatchIdentityTaggedTerminalExec(t *testing.T) {
+	t.Setenv(wave1TraceEnv, "1")
+	req := wave1TaggedRequest(t, "printf RAW_SECRET_FIXTURE # GWC_TRACE_TAG=W1_TEST")
+	var buf bytes.Buffer
+	logger := slog.New(slog.NewJSONHandler(&buf, nil))
+
+	dispatchID := injectWave1DispatchIdentity(logger, req)
+	require.NotEmpty(t, dispatchID)
+	_, err := uuid.Parse(dispatchID)
+	require.NoError(t, err)
+
+	var params map[string]any
+	require.NoError(t, json.Unmarshal(req.Params, &params))
+	meta, ok := params["_meta"].(map[string]any)
+	require.True(t, ok)
+	require.Equal(t, "preserved", meta["existing"])
+	require.Equal(t, dispatchID, meta[wave1DispatchMetaKey])
+
+	logText := buf.String()
+	require.Contains(t, logText, "wave1 diagnostic dispatch identity")
+	require.Contains(t, logText, dispatchID)
+	require.Contains(t, logText, "W1_TEST")
+	require.NotContains(t, logText, "RAW_SECRET_FIXTURE")
+	require.NotContains(t, logText, "printf")
+}
+
+func TestInjectWave1DispatchIdentityRequiresControlledTag(t *testing.T) {
+	t.Setenv(wave1TraceEnv, "1")
+	req := wave1TaggedRequest(t, "printf RAW_SECRET_FIXTURE")
+	before := append([]byte(nil), req.Params...)
+
+	require.Empty(t, injectWave1DispatchIdentity(slog.Default(), req))
+	require.Equal(t, before, []byte(req.Params))
+}
