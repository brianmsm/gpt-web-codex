+package dispatcherinternal
+
+import (
+	"encoding/json"
+	"log/slog"
+	"os"
+	"regexp"
+
+	"github.com/google/uuid"
+	"github.com/modelcontextprotocol/go-sdk/jsonrpc"
+)
+
+const (
+	wave1TraceEnv        = "TUNNEL_CLIENT_WAVE1_TRACE"
+	wave1DispatchMetaKey = "io.openai.gwc/wave1-dispatch-id"
+)
+
+var wave1TraceTagPattern = regexp.MustCompile("(?:^|[\\s#;])GWC_TRACE_TAG=([A-Za-z0-9._:-]{1,128})(?:$|[\\s;&|#])")
+
+func injectWave1DispatchIdentity(logger *slog.Logger, req *jsonrpc.Request) string {
+	if os.Getenv(wave1TraceEnv) != "1" || req == nil || req.Method != "tools/call" {
+		return ""
+	}
+
+	var params map[string]any
+	if err := json.Unmarshal(req.Params, &params); err != nil {
+		return ""
+	}
+	if name, _ := params["name"].(string); name != "terminal_exec" {
+		return ""
+	}
+	arguments, ok := params["arguments"].(map[string]any)
+	if !ok {
+		return ""
+	}
+	command, ok := arguments["command"].(string)
+	if !ok {
+		return ""
+	}
+	match := wave1TraceTagPattern.FindStringSubmatch(command)
+	if len(match) != 2 {
+		return ""
+	}
+
+	meta, _ := params["_meta"].(map[string]any)
+	if meta == nil {
+		meta = map[string]any{}
+	}
+	dispatchID := uuid.NewString()
+	meta[wave1DispatchMetaKey] = dispatchID
+	params["_meta"] = meta
+
+	encoded, err := json.Marshal(params)
+	if err != nil {
+		return ""
+	}
+	req.Params = encoded
+
+	if logger != nil {
+		logger.Info(
+			"wave1 diagnostic dispatch identity",
+			slog.String("wave1_dispatch_id", dispatchID),
+			slog.String("trace_tag", match[1]),
+		)
+	}
+	return dispatchID
+}
