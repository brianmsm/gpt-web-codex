{
  "name": "gpt-web-codex",
  "version": "2.3.0",
  "private": true,
  "description": "Shell-first ChatGPT-to-local MCP bridge with persistent Herdr PTYs and optional Luna.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianmsm/gpt-web-codex.git"
  },
  "homepage": "https://github.com/brianmsm/gpt-web-codex#readme",
  "bugs": {
    "url": "https://github.com/brianmsm/gpt-web-codex/issues"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "bin": {
    "gpt-web-codex": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "scripts": {
    "start": "bun run scripts/start-launcher.ts",
    "setup": "bun run src/cli.ts setup",
    "doctor": "bun run src/cli.ts doctor",
    "test": "bun test --timeout 15000 tests/*.test.ts",
    "audit": "bun audit",
    "check-version": "bun run scripts/check-version.ts",
    "typecheck": "tsc --noEmit",
    "licenses": "bun run scripts/generate-third-party-notices.ts --include-launcher",
    "clean": "bun run scripts/clean.ts",
    "build": "bun run scripts/build-runtime-bundle.ts",
    "smoke": "bun run scripts/smoke-release.ts dist/runtime",
    "smoke:herdr": "bun run scripts/smoke-herdr.ts",
    "launcher": "bun run scripts/start-launcher.ts",
    "app": "bun run scripts/start-launcher.ts",
    "app:package": "bun run --cwd launcher package",
    "app:smoke": "bun run --cwd launcher smoke:package",
    "launcher:dev": "bun run --cwd launcher dev",
    "launcher:typecheck": "bun run --cwd launcher typecheck",
    "launcher:build": "bun run --cwd launcher build",
    "launcher:test": "bun run --cwd launcher test",
    "verify": "bun run scripts/verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.2",
    "sharp": "0.35.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/turndown": "5.0.5",
    "chromium-bidi": "12.1.0",
    "playwright-core": "^1.62.0",
    "tiktoken": "1.0.22",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "zod-to-json-schema": "3.25.1",
    "qs": "6.16.1",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.4"
  },
  "keywords": [
    "chatgpt",
    "mcp",
    "persistent-shell",
    "herdr",
    "codex"
  ],
  "license": "MIT"
}
